{
	"name": "tobimori/kirby-logo-soup",
	"description": "Logo visual harmonization & normalization for Kirby CMS (Port of react-logo-soup)",
	"type": "kirby-plugin",
	"version": "1.1.1",
	"license": "MIT",
	"homepage": "https://github.com/tobimori/kirby-logo-soup#readme",
	"authors": [
		{
			"name": "Tobias Möritz",
			"email": "tobias@moeritz.io"
		}
	],
	"require": {
		"php": ">=8.3.0",
		"getkirby/composer-installer": "^1.2",
		"ext-imagick": "*"
	},
	"require-dev": {
		"carthage-software/mago": "^1.61.0",
		"getkirby/cms": "^5.6.4"
	},
	"scripts": {
		"analyze": "mago analyze",
		"dist": "composer install --no-dev --optimize-autoloader",
		"fix": [
			"mago lint --fix",
			"mago fmt"
		],
		"fmt": "mago fmt",
		"fmt:check": "mago fmt --check",
		"lint": "mago lint",
		"test": "php tests/run.php"
	},
	"config": {
		"optimize-autoloader": true,
		"allow-plugins": {
			"carthage-software/mago": true,
			"getkirby/composer-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"tobimori\\": "classes/"
		}
	},
	"extra": {
		"kirby": {
			"compatible": "^5.6.2 || ^6.0"
		},
		"kirby-cms-path": false
	}
}
